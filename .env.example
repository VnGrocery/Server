# Server
PORT=5000

# Storage backend selection.
# MongoDB is the only supported backend; the Firestore repositories were removed.
MONGODB_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=vngrocery
FIREBASE_ENABLED=false

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# Backend Auth (JWT)
JWT_SECRET=replace-with-a-long-random-secret

# Google Login (optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
BOOTSTRAP_ADMIN_EMAILS=admin@admin.com

# HashiCorp Vault for account keys
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=your-vault-token
VAULT_KV_MOUNT=secret
VAULT_KEYS_PATH_PREFIX=account-keys

# Besu QBFT integrity anchoring
BESU_ENABLED=false
BESU_WORKER_ENABLED=true
BESU_IMAGE=hyperledger/besu:24.3.3
BESU_RPC_URL=http://127.0.0.1:8545
# Comma-separated failover endpoints. The client rotates across all healthy endpoints.
BESU_RPC_URLS=http://127.0.0.1:8545
BESU_CHAIN_ID=1337
BESU_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BESU_FROM_ADDRESS=0x0000000000000000000000000000000000000000
BESU_PRIVATE_KEY=required-when-besu-enabled
BESU_GAS_LIMIT=250000
BESU_RECEIPT_TIMEOUT_SEC=30
BESU_PENDING_INTERVAL_SEC=3
BESU_VERIFY_INTERVAL_SEC=8
BESU_PENDING_BATCH_SIZE=25
BESU_VERIFY_BATCH_SIZE=50

ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SMTP_TO=
ALERT_TIMEOUT_SEC=5

IPFS_ENABLED=false
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp

RATE_LIMIT_BACKEND=memory
RATE_LIMIT_COLLECTION=rate_limits
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SEC=60
ADMIN_RATE_LIMIT_MAX_REQUESTS=30
ADMIN_RATE_LIMIT_WINDOW_SEC=60

# Read cache
CACHE_BACKEND=none
CACHE_PREFIX=vngrocery:cache:
CACHE_TTL_SECONDS=10
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Vision
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
VISION_PROMPT_VERSION=v1

# Host port for the API container (macOS: 5000 is taken by AirPlay Receiver)
API_PORT=5000

# Prefix for image URLs handed to clients. Must be reachable from the phone,
# not from inside the compose network. Defaults to the Android emulator's host
# alias; use your LAN address (e.g. http://192.168.1.20:8080) for a real device.
IPFS_PUBLIC_GATEWAY_URL=http://10.0.2.2:8080

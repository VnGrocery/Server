#!/usr/bin/env bash
#
# vng - single entry point for running the VnGrocery stack.
#
# Replaces the previous set of overlapping scripts (run-all.sh, up-deploy.sh,
# run-full-stack.sh, run-blockchain.sh, init-vault.sh). Everything goes through
# one command so there is only one order of operations to remember.
#
#   ./scripts/vng up                 # dev stack, single-node Besu
#   ./scripts/vng up --prod          # + nginx proxy, persistent vault, log rotation
#   ./scripts/vng up --qbft          # 4-validator cluster instead of 1 node (demo)
#   ./scripts/vng down / status / logs [service] / health / reset
#   ./scripts/vng contract-deploy    # deploy IntegrityRegistry, writes .env
#   ./scripts/vng vault-init         # init/unseal persistent vault (prod only)
#   ./scripts/vng e2e                # end-to-end API smoke test
#   ./scripts/vng seed               # fill with demo shops, products, pledges
#   ./scripts/vng seed-history       # give every product 30 days of price changes
#   ./scripts/vng seed-images        # give every product a photo, stored on IPFS
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$SERVER_DIR"

PROFILE=dev
CHAIN=single
ARGS=()

for arg in "$@"; do
  case "$arg" in
    --prod)  PROFILE=prod ;;
    --dev)   PROFILE=dev ;;
    --qbft)  CHAIN=qbft ;;
    --no-chain) CHAIN=none ;;
    *) ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

COMMAND="${1:-help}"
shift || true

# ---------------------------------------------------------------- compose files
compose_files=(-f docker-compose.yml)
case "$CHAIN" in
  single) compose_files+=(-f docker-compose.besu.yml) ;;
  qbft)   compose_files+=(-f docker-compose.besu-qbft.yml) ;;
  none)   : ;;
esac
[[ "$PROFILE" == "prod" ]] && compose_files+=(-f docker-compose.prod.yml)

dc() { docker compose "${compose_files[@]}" "$@"; }

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

VAULT_INIT_FILE="$SERVER_DIR/secrets/vault-init.json"

# Brings Vault up, initialises it the first time, and unseals it after that.
#
# Vault used to run in `-dev` mode, which keeps its whole store in memory. Every
# `vng up` therefore wiped every account's Ed25519 signing key. Nothing looked
# broken — reads come from Mongo — but the next write failed with a Vault 404
# from deep inside the signing path, and the demo data could no longer be
# extended. The file backend keeps the keys across restarts; the cost is that
# Vault now starts sealed, which is what this handles.
#
# One unseal key, threshold one. That is deliberately not how a production
# Vault should be set up, and prod uses its own overlay: here the whole point is
# that a stack anyone can start must not need a human holding key shares.
ensure_vault() {
  info "Starting Vault"
  dc up -d vault >/dev/null

  local ready=""
  for _ in $(seq 1 45); do
    # Sealed and uninitialised both answer here; only a Vault that is not
    # listening at all does not.
    if curl -fsS --max-time 2 \
      "http://127.0.0.1:8200/v1/sys/health?sealedcode=200&uninitcode=200&standbycode=200" \
      >/dev/null 2>&1; then
      ready=yes
      break
    fi
    sleep 1
  done
  [[ -n "$ready" ]] || die "Vault did not start. Check: ./scripts/vng logs vault"

  local initialised
  initialised="$(curl -fsS --max-time 5 \
    "http://127.0.0.1:8200/v1/sys/health?sealedcode=200&uninitcode=200&standbycode=200" \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["initialized"])')"

  if [[ "$initialised" != "True" ]]; then
    info "Initialising Vault for the first time"
    mkdir -p "$SERVER_DIR/secrets"
    dc exec -T vault vault operator init -key-shares=1 -key-threshold=1 -format=json \
      > "$VAULT_INIT_FILE" || die "Vault init failed"
    chmod 600 "$VAULT_INIT_FILE"
    warn "Unseal key and root token written to secrets/vault-init.json - keep it, Vault cannot be opened without it"
  fi

  [[ -f "$VAULT_INIT_FILE" ]] || die "Vault is initialised but secrets/vault-init.json is missing, so it cannot be unsealed. Restore that file, or wipe Vault with: ./scripts/vng reset"

  local unseal_key root_token
  unseal_key="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["unseal_keys_b64"][0])' "$VAULT_INIT_FILE")"
  root_token="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["root_token"])' "$VAULT_INIT_FILE")"

  if ! dc exec -T vault vault status >/dev/null 2>&1; then
    info "Unsealing Vault"
    dc exec -T vault vault operator unseal "$unseal_key" >/dev/null \
      || die "Vault unseal failed. If you wiped the volume, delete secrets/vault-init.json and run up again."
  fi

  # Dev mode mounted kv-v2 at secret/ for us; the file backend does not.
  if ! dc exec -T vault sh -lc "VAULT_TOKEN='$root_token' vault secrets list -format=json" \
      | grep -q '"secret/"'; then
    info "Enabling the kv-v2 store account keys live in"
    dc exec -T vault sh -lc "VAULT_TOKEN='$root_token' vault secrets enable -path=secret kv-v2" >/dev/null \
      || die "Could not enable the kv-v2 secrets engine"
  fi

  # The API reads this through docker-compose's ${VAULT_TOKEN} interpolation.
  export VAULT_TOKEN="$root_token"
}

require_env_file() {
  if [[ ! -f "$SERVER_DIR/.env" ]]; then
    warn ".env not found - creating it from .env.example"
    cp "$SERVER_DIR/.env.example" "$SERVER_DIR/.env"
    warn "Edit .env and set JWT_SECRET / OPENAI_API_KEY before using the API for real."
  fi
}

# The besu overlay refuses to start without a deployed contract address, so give
# a clear next step instead of a raw compose variable error.
require_contract() {
  [[ "$CHAIN" == "none" ]] && return 0
  local addr
  addr="$(grep -E '^BESU_CONTRACT_ADDRESS=' "$SERVER_DIR/.env" 2>/dev/null | cut -d= -f2- || true)"
  if [[ -z "$addr" || "$addr" == "0x0000000000000000000000000000000000000000" ]]; then
    cat >&2 <<EOF

IntegrityRegistry is not deployed yet, so the API cannot anchor hashes.

  1) ./scripts/vng chain-up          # start the chain on its own
  2) ./scripts/vng contract-deploy   # deploy + write BESU_CONTRACT_ADDRESS to .env
  3) ./scripts/vng up                # start the whole stack

Or run ./scripts/vng up --no-chain to start without blockchain anchoring.
EOF
    exit 1
  fi
}

# Host port the API is published on. The container always listens on 5000; the
# host side is 5050 by default because macOS AirPlay Receiver owns 5000.
api_port() {
  local port=""
  [[ -f "$SERVER_DIR/.env" ]] &&
    port="$(grep -E '^API_PORT=' "$SERVER_DIR/.env" | cut -d= -f2- || true)"
  echo "${port:-5050}"
}

summary() {
  cat <<EOF

Stack is up (profile=$PROFILE, chain=$CHAIN). Endpoints:
  API            http://localhost:$(api_port)/health
  MongoDB        mongodb://localhost:27017
  Vault          http://localhost:8200
  IPFS API       http://localhost:5001
  Besu RPC       http://localhost:8545
$([[ "$PROFILE" == "prod" ]] && echo "  Nginx proxy    http://localhost:80")

  ./scripts/vng status
  ./scripts/vng logs api
  ./scripts/vng health
EOF
}

case "$COMMAND" in
  up)
    require_env_file
    require_contract
    info "Validating compose files"
    dc config >/dev/null
    # Before the rest of the stack: the API refuses to start against a sealed
    # Vault, and it needs the root token this produces.
    ensure_vault
    info "Starting stack (profile=$PROFILE, chain=$CHAIN)"
    dc up -d --build "$@"
    summary
    ;;

  chain-up)
    require_env_file
    info "Starting blockchain only (chain=$CHAIN)"
    case "$CHAIN" in
      single) dc up -d besu ;;
      qbft)   dc up -d besu-validator1 besu-validator2 besu-validator3 besu-validator4 \
                        besu-rpc1 besu-rpc2 besu-rpc-proxy ;;
      none)   die "--no-chain has nothing to start" ;;
    esac
    info "Waiting for RPC on http://127.0.0.1:8545"
    for _ in $(seq 1 30); do
      if curl -fsS --max-time 2 -H 'Content-Type: application/json' \
        -d '{"jsonrpc":"2.0","method":"eth_blockNumber","params":[],"id":1}' \
        http://127.0.0.1:8545 >/dev/null 2>&1; then
        info "RPC is up"
        exit 0
      fi
      sleep 2
    done
    die "RPC did not come up. Check: ./scripts/vng logs besu"
    ;;

  down)    info "Stopping stack"; dc down "$@" ;;
  restart) info "Restarting stack"; dc down; dc up -d --build; dc ps ;;
  status)  dc ps ;;
  logs)    if [[ $# -gt 0 ]]; then dc logs -f "$1"; else dc logs -f; fi ;;
  config)  dc config ;;

  health)
    info "API"
    curl -fsS --max-time 5 "http://localhost:$(api_port)/health" && echo ||
      warn "API not responding"
    info "Blockchain"
    "$SCRIPT_DIR/check-blockchain.sh"
    ;;

  reset)
    warn "This deletes all containers AND volumes (mongo, vault, ipfs, redis, chain data)."
    read -r -p "Type 'yes' to continue: " confirm
    [[ "$confirm" == "yes" ]] || die "Aborted"
    dc down -v --remove-orphans
    info "Reset complete. Contract must be redeployed: ./scripts/vng contract-deploy"
    ;;

  contract-deploy)
    require_env_file
    info "Deploying IntegrityRegistry"
    log="$(mktemp "${TMPDIR:-/tmp}/vng-deploy.XXXXXX")"
    trap 'rm -f "$log"' EXIT
    # Stream to stdout and keep a copy to parse; /dev/tty is not available in CI.
    "$SCRIPT_DIR/deploy-integrity.sh" "$@" 2>&1 | tee "$log"
    address="$(sed -n 's/^  contractAddress: \(0x[0-9a-fA-F]*\).*/\1/p' "$log" | head -1)"
    deployer="$(sed -n 's/^  deployer: \(0x[0-9a-fA-F]*\).*/\1/p' "$log" | head -1)"
    [[ -n "$address" ]] || die "Could not parse the deployed contract address"

    # Persist so the next `vng up` picks it up without manual editing.
    set_env() {
      local key="$1" value="$2"
      if grep -q "^$key=" "$SERVER_DIR/.env"; then
        sed -i.bak "s|^$key=.*|$key=$value|" "$SERVER_DIR/.env"
      else
        printf '%s=%s\n' "$key" "$value" >> "$SERVER_DIR/.env"
      fi
    }
    set_env BESU_CONTRACT_ADDRESS "$address"
    set_env BESU_ENABLED true
    [[ -n "$deployer" ]] && set_env BESU_FROM_ADDRESS "$deployer"

    # Anchoring transactions must be signed by the contract owner, i.e. the same
    # account that deployed it. Without this the worker silently leaves every
    # pledge in pending_anchor. This is the well-known Besu dev account funded by
    # besu/dev/genesis.json - replace it before running against a real chain.
    current_key="$(grep -E '^BESU_PRIVATE_KEY=' "$SERVER_DIR/.env" | cut -d= -f2- || true)"
    if [[ -z "$current_key" || "$current_key" == "required-when-besu-enabled" ]]; then
      set_env BESU_PRIVATE_KEY "${BESU_PRIVATE_KEY:-8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63}"
      warn "BESU_PRIVATE_KEY was a placeholder; set to the local dev deployer key."
    fi
    rm -f "$SERVER_DIR/.env.bak"
    info "Wrote to .env: BESU_ENABLED=true BESU_CONTRACT_ADDRESS=$address"
    ;;

  vault-init)
    [[ "$PROFILE" == "prod" ]] || die "vault-init only applies to --prod (dev Vault auto-unseals)"
    dc up -d vault
    info "Vault status:"
    dc exec vault vault status -address=http://127.0.0.1:8200 || true
    cat <<'EOF'

If "Initialized false", run once and save the output somewhere safe:
  ./scripts/vng --prod exec-vault "vault operator init -address=http://127.0.0.1:8200"

If "Sealed true", unseal with 3 different keys:
  ./scripts/vng --prod exec-vault "vault operator unseal -address=http://127.0.0.1:8200"
EOF
    ;;

  exec-vault)
    dc exec vault sh -lc "$*"
    ;;

  seed-images)
    require_env_file
    info "Giving every product a photo (downloads once, then uploads to IPFS)"
    python3 "$SCRIPT_DIR/seed_images.py" "$@"
    ;;

  e2e)
    "$SCRIPT_DIR/e2e-mobile-flow.sh" "$@"
    ;;

  seed)
    require_env_file
    info "Seeding demo data"
    python3 "$SCRIPT_DIR/seed_demo.py" \
      --base-url "http://localhost:$(api_port)" "$@"
    ;;

  seed-history)
    require_env_file
    info "Generating backdated price history"
    # Needs the host-side addresses and the same Vault token the API container
    # uses: the events are signed for real, so it has to reach the same Vault.
    MONGODB_ENABLED=true \
    MONGODB_URI="mongodb://localhost:27017" \
    MONGODB_DATABASE=vngrocery \
    VAULT_ENABLED=true \
    VAULT_ADDR="http://localhost:8200" \
    VAULT_TOKEN="$(dc exec -T api printenv VAULT_TOKEN | tr -d '\r')" \
    VAULT_KV_MOUNT=secret \
    VAULT_KEYS_PATH_PREFIX=account-keys \
      go run "$SERVER_DIR/cmd/seed-price-history" "$@"
    ;;

  help|-h|--help)
    awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"
    cat <<EOF

Flags (can be combined with any command):
  --prod        production overlay (nginx proxy, persistent vault, restart:always)
  --qbft        use the 4-validator cluster instead of a single Besu node
  --no-chain    run without any blockchain service

Commands:
  up, down, restart, status, logs [service], config
  chain-up          start only the blockchain
  health            check API + chain
  reset             wipe containers and volumes (asks for confirmation)
  contract-deploy   deploy IntegrityRegistry and update .env
  vault-init        initialise persistent Vault (--prod only; dev is automatic)
  e2e               end-to-end API smoke test
  seed              fill the database with believable demo data
  seed-history      give every product a month of signed price changes
  seed-images       give every product a photo, stored on the project's IPFS node
EOF
    ;;

  *) die "Unknown command: $COMMAND (try ./scripts/vng help)" ;;
esac

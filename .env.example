# Server
PORT=5000

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# Backend Auth (JWT)
JWT_SECRET=replace-with-a-long-random-secret

# Google Login (optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# HashiCorp Vault for account keys
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=your-vault-token
VAULT_KV_MOUNT=secret
VAULT_KEYS_PATH_PREFIX=account-keys

# Besu QBFT integrity anchoring
BESU_ENABLED=false
BESU_RPC_URL=http://127.0.0.1:8545
BESU_CHAIN_ID=1337
BESU_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BESU_FROM_ADDRESS=0x0000000000000000000000000000000000000000
BESU_PRIVATE_KEY=
BESU_GAS_LIMIT=250000
BESU_RECEIPT_TIMEOUT_SEC=15
BESU_PENDING_INTERVAL_SEC=10
BESU_VERIFY_INTERVAL_SEC=60
BESU_PENDING_BATCH_SIZE=25
BESU_VERIFY_BATCH_SIZE=50

ALERT_WEBHOOK_URL=
ALERT_TIMEOUT_SEC=5

IPFS_ENABLED=false
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080

RATE_LIMIT_BACKEND=memory
RATE_LIMIT_COLLECTION=rate_limits
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SEC=60

# AI Vision
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
VISION_PROMPT_VERSION=v1
